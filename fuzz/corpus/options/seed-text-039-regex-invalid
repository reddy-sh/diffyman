    "case": false,
    "blankLines": false,
    "regex": [
      "port = \\d+",
      "(?P<count>\\d+"
    ]
  },
  "context": 3,
  "positionEncoding": "utf-8",
  "detectMoves": false,
  "adapter": "auto"
}
