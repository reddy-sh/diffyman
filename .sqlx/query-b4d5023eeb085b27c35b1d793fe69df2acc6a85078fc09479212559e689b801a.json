  "query": "SELECT b.sha256, b.size, b.media_type, b.created_at, b.expires_at\n         FROM blobs b JOIN blob_grants g ON g.sha256 = b.sha256\n         WHERE b.sha256 = $1 AND g.api_key_id IS NOT DISTINCT FROM $2 AND g.expires_at > now()",
