{
  "db_name": "PostgreSQL",
  "query": "WITH next AS (\n             SELECT id FROM jobs\n             WHERE status = 'queued' AND run_after <= now()\n             ORDER BY run_after, id\n             LIMIT $1\n             FOR UPDATE SKIP LOCKED\n         )\n         UPDATE jobs AS j\n         SET status = 'running',\n             attempts = j.attempts + 1,\n             lease_owner = $2,\n             lease_expires_at = now() + make_interval(secs => $3),\n             heartbeat_at = now(),\n             started_at = COALESCE(j.started_at, now())\n         FROM next\n         WHERE j.id = next.id\n         RETURNING j.*",
