# Rust
target/
**/*.rs.bk

# Node / WASM
node_modules/
# wasm-pack output (pkg/, pkg-web/, pkg-node/, ...) is never committed.
/bindings/wasm/pkg*/
# Node addon and the native type stubs written by `napi build` (bindings/node)
/bindings/node/*.node
/bindings/node/native.d.ts
# Platform package folders `napi create-npm-dirs` writes (scripts/stage-npm-packages.mjs)
/bindings/node/npm/
dist/
coverage/
*.tsbuildinfo
# `npm pack` tarballs (a corpus input may still be a .tgz)
*.tgz
!/tests/corpus/**/*.tgz

# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
# Native extension copied in by `maturin develop`
/bindings/python/python/diffyman/*.so
/bindings/python/python/diffyman/*.pyd

# Java
/bindings/java/target/
*.class

# Local secrets and config
.env
.env.*
!.env.example
*.local.json
# diffyman-server's own configuration file (it may hold a database URL)
/diffyman.toml
# Database backups (scripts/backup-db.sh) if their folder is inside the repository
*.dump
*.dump.sha256

# Editors and OS
.idea/
.vscode/
.DS_Store
