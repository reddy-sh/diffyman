# npm 10 fails to resolve vitest's optional peer chain (@vitest/mocker -> msw)
# with "Cannot read properties of null (reading 'edgesOut')". Every peer this
# package needs (react, vite, @types/node) is a direct devDependency, so peers
# are not auto-installed.
legacy-peer-deps=true
# Exact versions only.
save-exact=true
