{
  "//": "Type-checks index.d.ts, the generated types and test/types-usage.ts (npm run types:check). Nothing is emitted.",
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2022",
    "lib": ["es2022"],
    "types": ["node"],
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": false
  },
  "files": ["index.d.ts", "types/document.d.ts", "test/types-usage.ts"]
}
